# =============================================================================
# ADVERSARIAL SEO RESEARCH PROJECT - ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# This file contains environment variables for the adversarial SEO research project.
# Copy this file to '.env' and fill in your actual API keys and configuration.
# 
# IMPORTANT: Never commit the '.env' file with real API keys to version control!
#

# =============================================================================
# API PROVIDER CONFIGURATION
# =============================================================================

# Primary API provider for LLM operations
# Options: 'openai', 'anthropic' (Claude), 'bedrock' (AWS LLaMA)
# RECOMMENDED: Start with 'anthropic' (Claude) for best results
API_PROVIDER=anthropic

# Embedding provider configuration (separate from LLM provider)
# Options: 'openai' (recommended, production-ready), 'gemini' (free tier alternative)
# RECOMMENDED: Use 'openai' for embeddings (most reliable)
EMBEDDING_PROVIDER=openai

# =============================================================================
# GOOGLE GEMINI API CONFIGURATION
# =============================================================================
# Required for Gemini embeddings (EMBEDDING_PROVIDER=gemini)
# Get your API key from: https://aistudio.google.com/app/apikey

GOOGLE_API_KEY=your_google_api_key_here
# Alternative name (both are supported)
# GEMINI_API_KEY=your_google_api_key_here

# =============================================================================
# ANTHROPIC CLAUDE API CONFIGURATION
# =============================================================================
# Required if API_PROVIDER=anthropic
# Get your API key from: https://console.anthropic.com/

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic specific model configuration
# Recommended models for adversarial SEO research:
# - claude-3-haiku-20240307: Fastest and most cost-effective ($0.25-$1.25 per 1M tokens)
# - claude-3-sonnet-20240229: Balanced performance ($3-$15 per 1M tokens)
# - claude-3-opus-20240229: Highest capability ($15-$75 per 1M tokens)
# - claude-3-5-sonnet-20241022: Latest and most capable Sonnet ($3-$15 per 1M tokens)
# - claude-3-5-haiku-20241022: Latest Haiku with improved capabilities ($0.25-$1.25 per 1M tokens)
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Anthropic request configuration
ANTHROPIC_MAX_TOKENS=1000
ANTHROPIC_TEMPERATURE=0.0
ANTHROPIC_TIMEOUT=60
ANTHROPIC_MAX_RETRIES=3

# WARNING: Estimated costs for full research study (50 trials):
# - claude-3-haiku: $2-10 total
# - claude-3-sonnet: $15-40 total
# - claude-3-opus: $40-150 total
# - claude-3-5-sonnet: $15-40 total
# - claude-3-5-haiku: $2-10 total
# Monitor usage at: https://console.anthropic.com/

# =============================================================================
# OPENAI API CONFIGURATION
# =============================================================================
# Required if API_PROVIDER=openai or EMBEDDING_PROVIDER=openai
# Also used as fallback for embeddings if Gemini fails
# Get your API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=your_openai_api_key_here

# Optional: Organization ID if using organization account
# OPENAI_ORG_ID=your_organization_id_here

# OpenAI specific model configuration
# Recommended models for adversarial SEO research:
# - gpt-3.5-turbo: Cost-effective baseline ($0.50-$1.50 per 1M tokens)
# - gpt-4: Higher quality results ($10-$30 per 1M tokens)  
# - gpt-4-turbo: Latest capabilities ($10-$30 per 1M tokens)
# - gpt-4o-mini: Fastest and cheapest GPT-4 class model ($0.15-$0.60 per 1M tokens)
OPENAI_MODEL=gpt-3.5-turbo

# OpenAI request configuration
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# WARNING: Estimated costs for full research study (50 trials):
# - gpt-3.5-turbo: $5-15 total
# - gpt-4: $25-75 total  
# - gpt-4-turbo: $25-75 total
# - gpt-4o-mini: $2-8 total
# Monitor usage at: https://platform.openai.com/usage

# =============================================================================
# AWS BEDROCK CONFIGURATION
# =============================================================================
# Required if API_PROVIDER=bedrock
# AWS credentials are automatically handled through 'aws configure' or IAM roles

# AWS region for Bedrock service (commonly us-east-1 or us-west-2)
AWS_REGION=us-west-1

# Optional: Specific profile if using multiple AWS profiles
# AWS_PROFILE=default

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Primary LLM model for ranking and text generation
# This should match your API_PROVIDER setting:
# - For API_PROVIDER=openai: Use gpt-3.5-turbo, gpt-4, gpt-4-turbo, gpt-4o-mini
# - For API_PROVIDER=anthropic: Use claude-3-haiku-20240307, claude-3-sonnet-20240229, claude-3-5-sonnet-20241022
# - For API_PROVIDER=bedrock: Use meta.llama3-8b-instruct-v1:0, meta.llama3-70b-instruct-v1:0
# MUST MATCH YOUR API_PROVIDER!
LLM_MODEL=claude-3-haiku-20240307

# Embedding model for vector search
# MUST MATCH YOUR EMBEDDING_PROVIDER!
# For EMBEDDING_PROVIDER=openai (recommended):
#   - text-embedding-3-small (1536 dims, $0.02 per 1M tokens, recommended)
#   - text-embedding-3-large (3072 dims, $0.13 per 1M tokens, higher quality)
#   - text-embedding-ada-002 (1536 dims, $0.10 per 1M tokens, legacy)
# For EMBEDDING_PROVIDER=gemini (free tier):
#   - text-embedding-004 (768 dims, free tier available)
EMBEDDING_MODEL=text-embedding-3-small

# Model parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1000

# =============================================================================
# QDRANT VECTOR DATABASE CONFIGURATION
# =============================================================================

# Qdrant connection settings (Docker service name when using docker-compose)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Collection name for storing document embeddings
QDRANT_COLLECTION=adversarial_seo_research

# Vector database settings
# Vector size is auto-detected from embedding model:
# - text-embedding-3-small (OpenAI): 1536 dimensions (recommended)
# - text-embedding-3-large (OpenAI): 3072 dimensions
# - text-embedding-ada-002 (OpenAI): 1536 dimensions
# - text-embedding-004 (Gemini): 768 dimensions
# VECTOR_SIZE=1536  # Auto-detected, uncomment to override
SIMILARITY_THRESHOLD=0.7

# =============================================================================
# EXPERIMENT CONFIGURATION
# =============================================================================

# Default number of trials for statistical significance
DEFAULT_NUM_TRIALS=50

# Batch processing settings
BATCH_SIZE=10
PARALLEL_WORKERS=4

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY=1.0
BACKOFF_MULTIPLIER=2.0

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

# Google Gemini API rate limits (free tier)
# https://ai.google.dev/gemini-api/docs/models/gemini#model-variations
GEMINI_REQUESTS_PER_MINUTE=1500
GEMINI_TOKENS_PER_MINUTE=1000000

# OpenAI API rate limits (adjust based on your tier)
OPENAI_REQUESTS_PER_MINUTE=60
OPENAI_TOKENS_PER_MINUTE=90000

# Anthropic Claude API rate limits (adjust based on your tier)
ANTHROPIC_REQUESTS_PER_MINUTE=50
ANTHROPIC_TOKENS_PER_MINUTE=40000

# AWS Bedrock rate limits (adjust based on your service limits)
BEDROCK_REQUESTS_PER_MINUTE=120
BEDROCK_TOKENS_PER_MINUTE=120000

# =============================================================================
# SAFETY AND ETHICS CONFIGURATION
# =============================================================================

# Enable ethical safeguards and content filtering
ENABLE_ETHICAL_CHECKS=true

# Restrict to fictional products only (required for research ethics)
FICTIONAL_PRODUCTS_ONLY=true

# Content safety settings
ENABLE_CONTENT_FILTER=true
BLOCK_HARMFUL_CONTENT=true

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file configuration
LOG_FILE=logs/adversarial_seo.log
MAX_LOG_SIZE_MB=100
LOG_BACKUP_COUNT=3

# Performance monitoring
ENABLE_PERFORMANCE_LOGGING=true
LOG_API_CALLS=true

# =============================================================================
# DEVELOPMENT AND TESTING
# =============================================================================

# Development mode settings
DEBUG_MODE=false
VERBOSE_OUTPUT=false

# Testing configuration
TEST_MODE=false
MOCK_API_CALLS=false

# Cache settings for development
ENABLE_RESPONSE_CACHE=true
CACHE_TTL_SECONDS=3600

# =============================================================================
# JUPYTER NOTEBOOK CONFIGURATION
# =============================================================================

# Jupyter settings (used by Docker)
JUPYTER_ENABLE_LAB=yes
JUPYTER_PORT=8888
JUPYTER_TOKEN=

# =============================================================================
# DOCKER ENVIRONMENT OVERRIDES
# =============================================================================
# These variables are automatically set by docker-compose.yml
# QDRANT_HOST=qdrant  # Overridden in Docker to use service name